---
/*
 * The career as a commit log, in native <details>.
 *
 * Every directory is rendered OPEN, and the screen collapses the ones it wants collapsed. That
 * is the opposite of the obvious way round, and it is deliberate: the complete, expanded
 * document is then what a crawler, a screen reader, a reader with JS off, and the printer all
 * receive, and collapsing is the enhancement. Doing it the other way made paper depend on how
 * each engine hides a closed <details> — which differs, and cost a whole printed page.
 *
 * Phase 2 layers keyboard navigation, live filtering and the plain/diff toggle on this markup.
 */
import { EXPERIENCE } from '../content/experience';
import { duration, fileCount, lineCount, openByDefault, period, serverFirst } from '../lib/derive';

export interface Props {
	/** /cv renders every directory expanded: paper has no affordance for opening one. */
	allOpen?: boolean;
}

const { allOpen = false } = Astro.props;
---

<section id="timeline" data-build="timeline" aria-labelledby="timeline-heading">
	<h2 id="timeline-heading" class="font-mono text-xs tracking-[0.18em] text-text-lo uppercase">
		Career, as a commit log
	</h2>

	<ol class="mt-8 space-y-10">
		{
			EXPERIENCE.map((role) => {
				const open = openByDefault(role);
				return (
					<li class="relative border-l border-border pl-6 sm:pl-8">
						{/* The commit dot, on the rail. */}
						<span
							aria-hidden="true"
							data-no-print
							class="absolute top-2 -left-[4.5px] size-[9px] rounded-full bg-accent"
						/>

						<header>
							<p class="font-mono text-xs text-text-lo">
								<span>{period(role)}</span>
								<span aria-hidden="true"> · </span>
								<span>{duration(role)}</span>
								<span aria-hidden="true"> · </span>
								<span>{role.location}</span>
							</p>
							<h3 class="font-display mt-2 text-2xl leading-tight font-semibold sm:text-[1.75rem]">
								{role.company}
								<span class="text-text-lo"> — {role.role}</span>
							</h3>
							{role.note && (
								<p class="mt-2 font-mono text-[0.8125rem] text-sx-type">{role.note}</p>
							)}
							<p class="mt-3 max-w-[64ch] text-[0.9375rem] leading-relaxed text-text-lo">
								{role.summary}
							</p>
							<p class="mt-4 font-mono text-xs text-text-lo">
								<span>
									{fileCount(role)} file{fileCount(role) === 1 ? '' : 's'} changed
								</span>
								<span aria-hidden="true"> · </span>
								<span class="text-sx-add">+{lineCount(role)}</span>
							</p>
						</header>

						<div class="mt-5 overflow-hidden rounded-lg border border-border bg-editor">
							{serverFirst(role.dirs).map((dir, index) => (
								<details
									open
									data-collapsed={!allOpen && dir.name !== open ? '' : undefined}
									class:list={['group', index > 0 && 'border-t border-border']}
								>
									<summary
										class="flex cursor-pointer items-center gap-2 px-4 py-3 font-mono text-[0.8125rem] marker:content-none hover:bg-surface"
									>
										<span
											aria-hidden="true"
											data-chevron
											data-no-print
											class="text-text-lo transition-transform duration-200 group-open:rotate-90"
										>
											▸
										</span>
										<span class="text-sx-type">{dir.name}/</span>
										<span class="text-text-lo">
											{dir.files.length} file{dir.files.length === 1 ? '' : 's'}
										</span>
									</summary>

									<div class="space-y-4 border-t border-border px-4 py-4">
										{dir.files.map((file) => (
											<div>
												<p data-path class="font-mono text-xs text-text-lo">
													{dir.name}/{file.path}
												</p>
												<ul class="mt-2 space-y-2">
													{file.lines.map((line) => (
														<li
															data-line
															class="flex gap-2.5 font-mono text-[0.8125rem] leading-relaxed"
														>
															<span
																aria-hidden="true"
																data-plus
																class="shrink-0 text-sx-add"
															>
																+
															</span>
															<span class="text-text-hi">{line.text}</span>
														</li>
													))}
												</ul>
											</div>
										))}
									</div>
								</details>
							))}
						</div>
					</li>
				);
			})
		}
	</ol>
</section>
