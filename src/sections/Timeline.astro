---
/*
 * The career as a commit log, rendered as a diff view rather than a bullet list with a plus in
 * front of it: a line-number gutter, a tinted add column, hunk headers, file-type colour, and
 * the lines themselves coloured the way an editor colours code (see lib/highlight).
 *
 * Every directory renders OPEN and the screen collapses the ones it wants collapsed. That is
 * the opposite of the obvious way round, and it is deliberate: the complete, expanded document
 * is then what a crawler, a screen reader, a reader with JS off, and the printer all receive,
 * and collapsing is the enhancement. Doing it the other way made paper depend on how each
 * engine hides a closed <details>, which differs, and cost a printed page.
 */
import { EXPERIENCE } from '../content/experience';
import { duration, fileCount, lineCount, openByDefault, period, serverFirst } from '../lib/derive';
import { extensionClass, highlightHtml } from '../lib/highlight';

export interface Props {
	/** /cv renders every directory expanded: paper has no affordance for opening one. */
	allOpen?: boolean;
}

const { allOpen = false } = Astro.props;
---

<section id="timeline" data-build="timeline" aria-labelledby="timeline-heading">
	<div class="flex flex-wrap items-center justify-between gap-3">
		<h2 id="timeline-heading" class="font-mono text-xs tracking-[0.18em] text-text-lo uppercase">
			Career, as a commit log
		</h2>

		{/* Hidden until the script that drives it has run. Nothing here is the only path to
		anything: every line is on the page already, and every directory opens by clicking it. */}
		<div class="flex items-center gap-2" data-timeline-tools data-no-print hidden>
			<label class="relative">
				<span class="sr-only">Filter the career by keyword</span>
				<input
					type="search"
					data-filter
					placeholder="filter…"
					autocomplete="off"
					class="w-36 rounded border border-border bg-surface px-2.5 py-1 font-mono text-[0.75rem] text-text-hi placeholder:text-text-lo/60 focus:border-accent/50 focus:outline-none sm:w-48"
				/>
			</label>
			<button
				type="button"
				data-plain
				aria-pressed="false"
				class="rounded border border-border px-2.5 py-1 font-mono text-[0.75rem] text-text-lo transition-colors duration-200 hover:border-accent/40 hover:text-text-hi aria-pressed:border-accent/50 aria-pressed:bg-accent/10 aria-pressed:text-accent"
			>
				plain
			</button>
		</div>
	</div>

	<p
		data-filter-status
		role="status"
		data-no-print
		class="mt-3 font-mono text-xs text-text-lo"
		hidden
	>
	</p>

	<ol class="mt-8 space-y-10">
		{
			EXPERIENCE.map((role) => {
				const open = openByDefault(role);
				return (
					<li data-role-entry class="relative border-l border-border pl-6 sm:pl-8">
						<span
							aria-hidden="true"
							data-no-print
							class="absolute top-2 -left-[4.5px] size-[9px] rounded-full bg-accent"
						/>

						<header>
							<p class="font-mono text-xs text-text-lo">
								<span class="text-sx-num">{period(role)}</span>
								<span aria-hidden="true"> · </span>
								<span>{duration(role)}</span>
								<span aria-hidden="true"> · </span>
								<span>{role.location}</span>
							</p>
							<h3 class="font-display mt-2 text-2xl leading-tight font-semibold sm:text-[1.75rem]">
								{role.company}
								<span class="text-text-lo"> — {role.role}</span>
							</h3>
							{role.note && (
								<p class="mt-2 font-mono text-[0.8125rem] text-sx-type">{role.note}</p>
							)}
							<p class="mt-3 max-w-[64ch] text-[0.9375rem] leading-relaxed text-text-lo">
								{role.summary}
							</p>
							<p class="mt-4 font-mono text-xs text-text-lo">
								<span>
									{fileCount(role)} file{fileCount(role) === 1 ? '' : 's'} changed
								</span>
								<span aria-hidden="true"> · </span>
								<span class="text-sx-add">+{lineCount(role)}</span>
								<span aria-hidden="true"> · </span>
								<span class="text-sx-del">−0</span>
							</p>
						</header>

						<div class="mt-5 overflow-hidden rounded-lg border border-border bg-editor">
							{serverFirst(role.dirs).map((dir, index) => (
								<details
									open
									data-dir={dir.name}
									data-collapsed={!allOpen && dir.name !== open ? '' : undefined}
									class:list={['group', index > 0 && 'border-t border-border']}
								>
									<summary class="flex cursor-pointer items-center gap-2 bg-surface/60 px-3 py-2 font-mono text-[0.8125rem] marker:content-none hover:bg-surface">
										<span
											aria-hidden="true"
											data-chevron
											data-no-print
											class="text-text-lo transition-transform duration-200 group-open:rotate-90"
										>
											▸
										</span>
										<span class="text-sx-type">{dir.name}/</span>
										<span class="text-text-lo">
											{dir.files.length} file{dir.files.length === 1 ? '' : 's'}
										</span>
										<span class="ml-auto font-mono text-[0.6875rem] text-sx-add">
											+{dir.files.reduce((sum, file) => sum + file.lines.length, 0)}
										</span>
									</summary>

									<div class="border-t border-border">
										{dir.files.map((file) => {
											const path = `${dir.name}/${file.path}`;
											return (
												<div data-file class="border-b border-border/60 last:border-b-0">
													{/* The hunk header, as a diff prints it. */}
													<p
														data-path
														class="flex items-center gap-2 px-3 py-1.5 font-mono text-[0.6875rem]"
													>
														<span aria-hidden="true" class="text-text-lo/50">
															@@
														</span>
														<span class={extensionClass(file.path)}>{path}</span>
														<span aria-hidden="true" class="text-text-lo/50">
															+{file.lines.length}
														</span>
													</p>

													<ul class="pb-1">
														{file.lines.map((line, lineIndex) => (
															<li
																data-line
																class="flex gap-0 bg-sx-add/[0.07] font-mono text-[0.8125rem] leading-relaxed"
															>
																<span
																	aria-hidden="true"
																	data-gutter
																	class="w-9 shrink-0 border-r border-border/60 px-2 text-right text-[0.6875rem] leading-relaxed text-text-lo/45 select-none"
																>
																	{lineIndex + 1}
																</span>
																<span
																	aria-hidden="true"
																	data-plus
																	class="w-6 shrink-0 text-center text-sx-add select-none"
																>
																	+
																</span>
																<span
																	class="py-0.5 pr-3 text-text-hi"
																	set:html={highlightHtml(line.text)}
																/>
															</li>
														))}
													</ul>
												</div>
											);
										})}
									</div>
								</details>
							))}
						</div>
					</li>
				);
			})
		}
	</ol>
</section>

<script>
	import { mountTimeline } from '../scripts/timeline';

	mountTimeline();
	document.addEventListener('astro:page-load', mountTimeline);
</script>
