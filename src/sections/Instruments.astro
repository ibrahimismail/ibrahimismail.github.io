---
/*
 * Two columns of numbers: the career's, and this page's.
 *
 * The career figures each trace to a line in the timeline, and none of them is rounded up. The
 * live ones are measured on the reader's own page view as it happens — which is the point of
 * the section. A counter animating up to 10× is decoration; LCP measured in front of you is
 * evidence, and it is the kind a reviewer can check.
 *
 * Every live cell ships with a placeholder that says what it is waiting for, so a browser that
 * cannot measure something shows that rather than a plausible number.
 */
import { EDUCATION } from '../content/education';
import { FACTS } from '../content/facts';
import { monthYear } from '../lib/derive';
---

<section id="instruments" data-build="instruments" aria-labelledby="instruments-heading">
	<h2
		id="instruments-heading"
		class="font-mono text-xs tracking-[0.18em] text-text-lo uppercase"
	>
		Instruments
	</h2>

	<dl class="mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-border bg-border sm:grid-cols-3 lg:grid-cols-5">
		{
			FACTS.map((fact) => (
				<div class="bg-surface p-4">
					<dt class="font-mono text-[0.6875rem] tracking-[0.14em] text-text-lo uppercase">
						{fact.label}
					</dt>
					<dd class="font-display mt-1.5 text-3xl leading-none font-semibold text-sx-num">
						{fact.value}
					</dd>
					<p class="mt-2 font-mono text-[0.6875rem] leading-snug text-text-lo">
						{fact.note}
					</p>
				</div>
			))
		}
	</dl>

	<h3 class="mt-10 font-mono text-xs tracking-[0.18em] text-text-lo uppercase">
		This page, measured
	</h3>
	<div
		data-instruments
		class="mt-4 grid gap-px overflow-hidden rounded-lg border border-border bg-border sm:grid-cols-2"
	>
		<dl class="grid grid-cols-2 gap-x-4 gap-y-2 bg-surface p-4 font-mono text-[0.8125rem]">
			{
				[
					['lcp', 'largest paint', 'measuring…'],
					['inp', 'first input', 'waiting for you'],
					['cls', 'layout shift', 'measuring…'],
					['frame', 'mean frame', 'sampling…'],
					['transferred', 'transferred', 'measuring…'],
					['requests', 'requests', '…'],
				].map(([key, label, placeholder]) => (
					<>
						<dt class="text-text-lo">{label}</dt>
						<dd data-live={key} class="text-right text-accent">
							{placeholder}
						</dd>
					</>
				))
			}
		</dl>
		<dl class="grid grid-cols-2 gap-x-4 gap-y-2 bg-surface p-4 font-mono text-[0.8125rem]">
			{
				[
					['page-html', 'this page, gzip', '…'],
					['css', 'css, gzip', '…'],
					['js', 'js, gzip', '…'],
					['nodes', 'dom nodes', '…'],
					['pages', 'pages built', '…'],
					['built', 'built', '…'],
				].map(([key, label, placeholder]) => (
					<>
						<dt class="text-text-lo">{label}</dt>
						<dd data-live={key} class="text-right text-text-hi">
							{placeholder}
						</dd>
					</>
				))
			}
		</dl>
	</div>
	<p class="mt-2 font-mono text-[0.6875rem] text-text-lo">
		Left: measured on your view, now. Right: written by the build that produced this page.
	</p>

	<h3 class="mt-10 font-mono text-xs tracking-[0.18em] text-text-lo uppercase">Education</h3>
	<ul class="mt-4 space-y-3">
		{
			EDUCATION.map((entry) => (
				<li class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
					<span class="font-mono text-xs text-text-lo">
						{monthYear(entry.start)} — {monthYear(entry.end)}
					</span>
					<span class="text-[0.9375rem] text-text-hi">{entry.degree}</span>
					<span class="text-[0.9375rem] text-text-lo">{entry.school}</span>
					{entry.gpa && (
						<span class="font-mono text-xs text-sx-num">GPA {entry.gpa}</span>
					)}
				</li>
			))
		}
	</ul>
</section>

<script>
	import { mountInstruments } from '../scripts/instruments';

	mountInstruments();
	document.addEventListener('astro:page-load', mountInstruments);
</script>
