---
/*
 * The career numbers, plus education. Phase 4 adds the live column — this page's own LCP, INP,
 * bytes shipped and frame time, measured on the visitor's view — next to them, which is the
 * whole point: an animated counter ticking to 10× is decoration, a number measured in front of
 * you is evidence.
 *
 * Every figure here traces to a line in the timeline. Nothing is rounded up.
 */
import { EDUCATION } from '../content/education';
import { FACTS } from '../content/facts';
import { monthYear } from '../lib/derive';
---

<section id="instruments" data-build="instruments" aria-labelledby="instruments-heading">
	<h2
		id="instruments-heading"
		class="font-mono text-xs tracking-[0.18em] text-text-lo uppercase"
	>
		Instruments
	</h2>

	<dl class="mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-border bg-border sm:grid-cols-3 lg:grid-cols-5">
		{
			FACTS.map((fact) => (
				<div class="bg-surface p-4">
					<dt class="font-mono text-[0.6875rem] tracking-[0.14em] text-text-lo uppercase">
						{fact.label}
					</dt>
					<dd class="font-display mt-1.5 text-3xl leading-none font-semibold text-accent">
						{fact.value}
					</dd>
					<p class="mt-2 font-mono text-[0.6875rem] leading-snug text-text-lo">
						{fact.note}
					</p>
				</div>
			))
		}
	</dl>

	<h3 class="mt-10 font-mono text-xs tracking-[0.18em] text-text-lo uppercase">Education</h3>
	<ul class="mt-4 space-y-3">
		{
			EDUCATION.map((entry) => (
				<li class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
					<span class="font-mono text-xs text-text-lo">
						{monthYear(entry.start)} — {monthYear(entry.end)}
					</span>
					<span class="text-[0.9375rem] text-text-hi">{entry.degree}</span>
					<span class="text-[0.9375rem] text-text-lo">{entry.school}</span>
					{entry.gpa && (
						<span class="font-mono text-xs text-sx-type">GPA {entry.gpa}</span>
					)}
				</li>
			))
		}
	</ul>
</section>
