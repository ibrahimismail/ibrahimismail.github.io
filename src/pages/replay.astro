---
/*
 * A link that runs the build sequence again, for anyone who skipped it or wants another look.
 * The head script treats /replay as a reason to arm the sequence whatever the "seen this week"
 * stamp says, and the canonical points back at / so the two are never indexed as duplicates.
 */
import Page from '../components/Page.astro';
---

<Page canonicalPath="/" />
