---
/*
 * The extension bus. The diagram and the default scenario's step list both render server-side,
 * so with no JavaScript this is a labelled diagram next to an ordered list of what happens —
 * which is the accessible version as well as the fallback. The script adds the travelling
 * packet, the scrubber, and the other four scenarios.
 */
import { EDGES, NODES, SCENARIOS } from '../content/bus';

const W = 150;
const H = 44;
const first = SCENARIOS[0];
const node = (id: string) => NODES.find((candidate) => candidate.id === id)!;
---

<div
	class="overflow-hidden rounded-lg border border-border bg-editor"
	data-bus
	data-scenarios={JSON.stringify(SCENARIOS)}
	data-nodes={JSON.stringify(NODES)}
>
	<div class="flex flex-wrap items-center gap-2 border-b border-border px-4 py-3">
		<span class="font-mono text-[0.6875rem] tracking-[0.14em] text-text-lo uppercase">
			Run
		</span>
		{
			SCENARIOS.map((scenario, index) => (
				<button
					type="button"
					data-scenario={scenario.id}
					aria-pressed={index === 0 ? 'true' : 'false'}
					class="rounded border border-border px-2.5 py-1 font-mono text-[0.75rem] text-sx-fn/80 transition-colors duration-200 hover:border-accent/40 hover:text-sx-fn aria-pressed:border-accent/50 aria-pressed:bg-accent/10 aria-pressed:text-accent"
				>
					{scenario.label}()
				</button>
			))
		}
	</div>

	<div class="overflow-x-auto">
		<svg
			viewBox="0 0 760 400"
			role="img"
			aria-label="The extension's message bus: content script, injected dialog and popup talk to an ephemeral service worker, which talks to the desktop client, the native Swift bridge and the API."
			class="w-full min-w-[640px]"
		>
			<g data-edges stroke="currentColor" class="text-border">
				{
					EDGES.map(([from, to]) => {
						const a = node(from);
						const b = node(to);
						return (
							<line
								data-edge={`${from}-${to}`}
								x1={a.x}
								y1={a.y}
								x2={b.x}
								y2={b.y}
								stroke-width="1.5"
								stroke-dasharray="4 4"
							/>
						);
					})
				}
			</g>

			<g data-nodes>
				{
					NODES.map((item) => (
						<g data-node={item.id} class="transition-opacity duration-200">
							<rect
								x={item.x - W / 2}
								y={item.y - H / 2}
								width={W}
								height={H}
								rx="6"
								class="fill-surface stroke-border"
								stroke-width="1"
							/>
							<text
								x={item.x}
								y={item.y - 2}
								text-anchor="middle"
								class="fill-text-hi font-mono text-[12px]"
							>
								{item.label}
							</text>
							<text
								x={item.x}
								y={item.y + 13}
								text-anchor="middle"
								class="fill-text-lo font-mono text-[10px]"
							>
								{item.sub}
							</text>
						</g>
					))
				}
			</g>

			{/* The travelling message. Parked and invisible until the script moves it. */}
			<circle data-packet r="6" cx="0" cy="0" class="fill-accent" opacity="0" />

			{/* Messages waiting on a worker that is not there. */}
			<g data-queue opacity="0">
				<rect
					x={node('sw').x + 52}
					y={node('sw').y - 40}
					width="34"
					height="20"
					rx="4"
					class="fill-warn/15 stroke-warn"
					stroke-width="1"
				/>
				<text
					data-queue-count
					x={node('sw').x + 69}
					y={node('sw').y - 26}
					text-anchor="middle"
					class="fill-warn font-mono text-[11px]">0</text
				>
			</g>
		</svg>
	</div>

	<div class="border-t border-border px-4 py-3">
		<p data-blurb class="text-[0.8125rem] text-text-lo">{first.blurb}</p>

		<ol data-log class="mt-3 space-y-1 font-mono text-[0.75rem] leading-relaxed">
			{
				first.hops.map((hop, index) => (
					<li
						data-step={index}
						class="flex gap-2.5 rounded px-1.5 py-1 text-text-lo transition-colors duration-200 aria-current:bg-accent/10 aria-current:text-text-hi"
					>
						<span aria-hidden="true" class="text-text-lo/50">
							{String(index + 1).padStart(2, '0')}
						</span>
						<span>{hop.label}</span>
					</li>
				))
			}
		</ol>

		<div class="mt-3 flex flex-wrap items-center gap-2" data-controls hidden>
			<button
				type="button"
				data-play
				class="rounded border border-accent/40 bg-accent/10 px-2.5 py-1 font-mono text-[0.75rem] text-accent transition-colors duration-200 hover:bg-accent/20"
			>
				Play
			</button>
			<button
				type="button"
				data-prev
				class="rounded border border-border px-2.5 py-1 font-mono text-[0.75rem] text-text-lo transition-colors duration-200 hover:border-accent/40 hover:text-text-hi"
				>Prev</button
			>
			<button
				type="button"
				data-next
				class="rounded border border-border px-2.5 py-1 font-mono text-[0.75rem] text-text-lo transition-colors duration-200 hover:border-accent/40 hover:text-text-hi"
				>Next</button
			>
			<input
				type="range"
				data-scrub
				min="0"
				max={first.hops.length - 1}
				value="0"
				aria-label="Step through the scenario"
				class="h-1 grow accent-accent"
			/>
		</div>
	</div>
</div>

<script>
	import { mountBus } from '../scripts/extension-bus';

	mountBus();
	document.addEventListener('astro:page-load', mountBus);
</script>
