---
/*
 * Act 0 — the build, as a split editor.
 *
 * Left: the agent's transcript, as tool-call cards that resolve from a spinner to a timing.
 * Right: the file it is writing, streaming in line by line and syntax-highlighted. When a file
 * lands, the section it produced is revealed behind the overlay; at the end the chrome peels
 * away and the reader is in the page.
 *
 * The source it streams is this site's own, read at build time with ?raw. That matters: a build
 * log full of invented code on an engineer's portfolio would be the one unforgivable detail.
 *
 * It is aria-hidden and inert, so a screen reader is handed the finished document and never
 * hears the performance. It only renders when the sequence is enabled and the reader has not
 * seen it this week — ThemeScript decides that before first paint.
 */
import profileSource from '../content/profile.ts?raw';
import experienceSource from '../content/experience.ts?raw';
import stackSource from '../content/stack.ts?raw';
import busSource from '../scripts/extension-bus.ts?raw';
import scopeSource from '../scripts/scope-engine.ts?raw';
import klikSource from '../scripts/kliknote.ts?raw';
import deriveSource from '../lib/derive.ts?raw';

import { EXPERIENCE } from '../content/experience';
import { SYSTEMS } from '../content/systems';
import { VENTURE } from '../content/venture';
import { excerpt, highlightCode } from '../lib/code';
import { TOTALS } from '../lib/derive';

type Step = {
	tool: 'Read' | 'Write' | 'Bash';
	arg: string;
	out: string;
	reveals?: string;
	/** Pre-highlighted lines, so the browser streams strings rather than tokenising at runtime. */
	code: string[];
	/** Dropped on a narrow screen, where the sequence runs six steps rather than nine. */
	optional?: boolean;
};

/*
 * The steps follow the content: a hidden section takes its step with it, rather than leaving
 * the transcript writing a file whose output nobody can scroll to.
 */
const steps: (Step | null)[] = [
	{
		tool: 'Read',
		arg: 'content/profile.ts',
		out: 'senior full-stack engineer · Beirut',
		reveals: 'masthead',
		code: highlightCode(excerpt(profileSource, 'export const PROFILE', 13)),
	},
	{
		tool: 'Read',
		arg: 'content/experience.ts',
		out: `${EXPERIENCE.length} roles · ${TOTALS.files} files · ${TOTALS.lines} lines`,
		reveals: 'timeline',
		code: highlightCode(excerpt(experienceSource, 'export const EXPERIENCE', 15)),
	},
	SYSTEMS.length
		? {
				tool: 'Write',
				arg: 'scripts/scope-engine.ts',
				out: 'resolver · transitive grants',
				reveals: 'systems',
				code: highlightCode(excerpt(scopeSource, 'function resolve(', 16)),
			}
		: null,
	SYSTEMS.length
		? {
				tool: 'Write',
				arg: 'scripts/extension-bus.ts',
				out: `${SYSTEMS.length} systems · 5 scenarios`,
				reveals: 'systems',
				optional: true,
				code: highlightCode(excerpt(busSource, 'function travel(hop', 15)),
			}
		: null,
	VENTURE
		? {
				tool: 'Write',
				arg: 'scripts/kliknote.ts',
				out: 'local-first · no network',
				reveals: 'venture',
				optional: true,
				code: highlightCode(excerpt(klikSource, 'function render()', 14)),
			}
		: null,
	{
		tool: 'Read',
		arg: 'lib/derive.ts',
		out: 'counts, periods, server-first ordering',
		reveals: 'timeline',
		optional: true,
		code: highlightCode(excerpt(deriveSource, 'export function duration', 14)),
	},
	{
		tool: 'Read',
		arg: 'content/stack.ts',
		out: 'two halves, server first',
		reveals: 'stack',
		code: highlightCode(excerpt(stackSource, 'export const STACK', 14)),
	},
	{
		tool: 'Bash',
		arg: 'npm run build',
		out: '',
		reveals: 'instruments',
		code: [],
	},
];

const plan = [
	'read the career, lay out the document, wire the interactives',
	'server-side first — ordering, not volume',
	'no framework: the islands are plain modules',
];
---

<div
	data-build-overlay
	data-steps={JSON.stringify(steps.filter(Boolean))}
	data-plan={JSON.stringify(plan)}
	data-pages={Object.keys(import.meta.glob('../pages/*.astro')).length}
	aria-hidden="true"
	inert
	class="fixed inset-0 z-50 flex flex-col bg-background font-mono text-[0.8125rem] transition-opacity duration-[280ms] data-[state=leaving]:opacity-0"
>
	{/* Window chrome. */}
	<div
		class="flex shrink-0 items-center gap-3 border-b border-border bg-surface/70 px-4 py-2.5 text-[0.75rem]"
	>
		<span aria-hidden="true" class="flex gap-1.5">
			<span class="size-2.5 rounded-full bg-sx-del/70"></span>
			<span class="size-2.5 rounded-full bg-sx-num/70"></span>
			<span class="size-2.5 rounded-full bg-sx-add/70"></span>
		</span>
		<span class="text-text-lo">ibrahimismail.dev</span>
		<span data-head-state class="text-sx-num">building…</span>
		<button
			type="button"
			data-skip
			class="ml-auto rounded border border-border px-2.5 py-1 text-text-lo transition-colors duration-200 hover:border-accent/40 hover:text-text-hi"
		>
			skip ⏎
		</button>
	</div>

	<div class="grid min-h-0 grow sm:grid-cols-[minmax(0,21rem)_minmax(0,1fr)]">
		{/* The agent. */}
		<aside class="min-h-0 overflow-hidden border-border sm:border-r">
			<div data-transcript class="h-full space-y-2 overflow-hidden p-4"></div>
		</aside>

		{/* What it is writing. */}
		<section class="hidden min-h-0 flex-col sm:flex">
			<div class="flex shrink-0 items-center gap-2 border-b border-border px-4 py-2 text-[0.75rem]">
				<span aria-hidden="true" data-code-dot class="size-1.5 rounded-full bg-sx-fn"></span>
				<span data-code-name class="text-text-lo">waiting…</span>
				<span data-code-state class="text-sx-add"></span>
			</div>
			<div class="min-h-0 grow overflow-hidden p-4">
				<ol data-code class="leading-[1.65]"></ol>
			</div>
		</section>
	</div>

	{/* The prompt, which stays behind as the palette. */}
	<div class="shrink-0 border-t border-border px-4 py-3">
		<p class="flex items-baseline gap-2">
			<span aria-hidden="true" class="text-accent">›</span>
			<span data-prompt class="text-text-hi"></span>
			<span aria-hidden="true" class="animate-[blink_1s_steps(2)_infinite] text-cursor">▍</span>
		</p>
	</div>
</div>

<script>
	import { runBuild } from '../build/driver';

	function start() {
		const overlay = document.querySelector<HTMLElement>('[data-build-overlay]');
		if (!overlay || overlay.dataset.ran) return;
		if (!document.documentElement.classList.contains('js-build')) return;
		overlay.dataset.ran = 'true';
		runBuild(overlay);
	}

	start();
	document.addEventListener('astro:page-load', start);
</script>
